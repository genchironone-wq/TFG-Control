<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Общий мир · TFG Control" Width="1240" Height="850" MinWidth="1080" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#24292D" Foreground="#E5E7E8" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#98A2A8"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="22"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#3A4248"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1"><GradientStop Color="#30373D" Offset="0"/><GradientStop Color="#292F34" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#111518" BlurRadius="22" ShadowDepth="8" Direction="310" Opacity="0.32"/></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#323A40"/><Setter Property="Foreground" Value="#DBDFE2"/><Setter Property="BorderBrush" Value="#414A51"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><Border.Effect><DropShadowEffect Color="#14191C" BlurRadius="12" ShadowDepth="4" Opacity="0.35"/></Border.Effect><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.30"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#FFF5EF"/><Setter Property="BorderBrush" Value="#DF9274"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#DF8965" Offset="0"/><GradientStop Color="#C96B4B" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#9EA8AE"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="T" CornerRadius="12" Background="Transparent" Padding="15,13" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#F1E3DB"/><Setter TargetName="T" Property="Background" Value="#353C41"/><Setter TargetName="T" Property="BorderBrush" Value="#454C51"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F0F1F1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#23292E"/><Setter Property="Foreground" Value="#E5E7E9"/><Setter Property="BorderBrush" Value="#424B53"/><Setter Property="Padding" Value="12"/><Setter Property="CaretBrush" Value="#EDAE8A"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E5E7E9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#DEE3E6"/><Setter Property="Background" Value="#2B3238"/><Setter Property="Padding" Value="12,10"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#414A51"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E5E7E9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#252D33" BorderBrush="#48525A" BorderThickness="1" CornerRadius="10"><Path Data="M 0,0 L 5,5 L 10,0" Stroke="#A9B2B8" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" Margin="14,0,40,0"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="#2B3238" BorderBrush="#48525A" BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="250"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Rail" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="5" CornerRadius="3"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Height" Value="32"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Rail}" Background="#CA805F" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Rail}" Background="#1C2328" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="26" Height="26"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#D18A69" Stroke="#E7A98C" StrokeThickness="2"><Ellipse.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.45"/></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <TabControl x:Name="Tabs" Background="#24292D" Foreground="#E5E7E8" TabStripPlacement="Left" BorderThickness="0" UseLayoutRounding="True">
  <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid Background="{TemplateBinding Background}"><Grid.ColumnDefinitions><ColumnDefinition Width="198"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#262C31" BorderBrush="#343C42" BorderThickness="0,0,1,0"><DockPanel Margin="18,28,18,20">
    <StackPanel DockPanel.Dock="Top" Margin="9,0,0,32"><Border Width="40" Height="40" HorizontalAlignment="Left" CornerRadius="12" Background="#343C42" BorderBrush="#485159" BorderThickness="1" Margin="0,0,0,16"><Viewbox Width="23" Height="23"><Canvas Width="28" Height="28"><Path Data="M 14,1 L 27,8 L 14,15 L 1,8 Z" Fill="#D79B76"/><Path Data="M 1,8 L 14,15 L 14,28 L 1,21 Z" Fill="#B87655"/><Path Data="M 14,15 L 27,8 L 27,21 L 14,28 Z" Fill="#8D5D48"/></Canvas></Viewbox></Border><TextBlock Text="Общий мир" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Сервер для друзей" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="5,18,5,0"><Button x:Name="OpenFolderButton" Content="Папка сервера  ↗" FontSize="11" Padding="8,10" Margin="0,0,0,18"/><TextBlock x:Name="StateLabel" Text="●  Остановлен" FontSize="12" Foreground="#A5AFB6"/><TextBlock x:Name="UptimeLabel" Text="Сервер на этом ПК" TextWrapping="Wrap" FontSize="10" Foreground="#748189" Margin="0,7,0,0"/><TextBlock Text="TFG CONTROL  ·  1.1" Foreground="#66737C" FontSize="9" Margin="0,17,0,0"/></StackPanel>
    <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" VerticalAlignment="Top"/>
   </DockPanel></Border>
   <ContentPresenter Grid.Column="1" Margin="28,24,28,20" ContentSource="SelectedContent"/>
  </Grid></ControlTemplate></TabControl.Template>
  <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Мой мир"/></StackPanel></TabItem.Header>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="Сервер для друзей" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Ваш общий мир" FontSize="31" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#2B3237" BorderBrush="#40494F" BorderThickness="1" CornerRadius="13" Padding="13,8"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#C18E70" Margin="0,0,8,0"/><TextBlock Text="TerraFirmaGreg" Foreground="#B7BFC4" FontSize="11"/></StackPanel></Border></Grid>
    <Grid Grid.Row="1" MinHeight="285"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="19,17,19,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="Мир онлайн" FontSize="16" FontWeight="SemiBold"/><Border HorizontalAlignment="Right" Background="#252C31" CornerRadius="8" Padding="8,4"><TextBlock Text="Схема мира" FontSize="10" Foreground="#8F9CA4"/></Border></Grid>
      <Grid x:Name="PlanetHost" Grid.Row="1" Background="Transparent" Cursor="Hand" ClipToBounds="True" Margin="0,3,0,0" ToolTip="Потяните мышью, чтобы повернуть. Планета — иллюстрация, позиции игроков условные."><Viewport3D x:Name="PlanetViewport" ClipToBounds="True"/><Canvas x:Name="PlanetOverlay" ClipToBounds="True"/></Grid>
      <Grid Grid.Row="2" Margin="0,6,0,0"><TextBlock x:Name="PlanetCaption" Text="Игроки появятся здесь после входа" FontSize="10" Foreground="#9BA6AE"/><TextBlock Text="Потяните, чтобы повернуть" FontSize="9" Foreground="#737F88" HorizontalAlignment="Right"/></Grid>
     </Grid></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="21"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Управление сервером" Foreground="#AAB3BA" FontSize="12"/>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,12"><Border Width="48" Height="48" HorizontalAlignment="Left" Background="#282F35" BorderBrush="#404950" BorderThickness="1" CornerRadius="24" Margin="0,0,0,13"><Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.38"/></Border.Effect><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="#D89B79" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="HeroTitle" Text="Готовы начать?" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="HeroDescription" Text="Запустите сервер и зовите друзей в общий мир." TextWrapping="Wrap" Foreground="#9CA8B0" FontSize="12" Margin="0,8,0,0" LineHeight="19"/></StackPanel>
      <Button x:Name="StartButton" Grid.Row="2" Style="{StaticResource Primary}" Content="Запустить сервер" Margin="0,0,0,10"/>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="Сохранить" IsEnabled="False" Padding="7,11" FontSize="12"/><Button x:Name="StopButton" Grid.Column="2" Content="Остановить" IsEnabled="False" Padding="7,11" FontSize="12"/></Grid>
      <TextBlock x:Name="RunHint" Grid.Row="4" Text="Всё необходимое уже внутри" HorizontalAlignment="Center" Foreground="#77858F" FontSize="10" Margin="0,13,0,0"/>
     </Grid></Border>
    </Grid>
    <UniformGrid Grid.Row="2" Columns="4" Margin="-6,18,-6,0">
     <Border Style="{StaticResource Card}" Margin="6" Padding="16,14"><StackPanel><TextBlock Text="В ИГРЕ" Foreground="#9BA6AF" FontSize="10"/><TextBlock x:Name="PlayersMetric" Text="— / 10" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock x:Name="PlayersCaption" Text="Ожидаем друзей" Foreground="#7E8C96" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="6" Padding="16,14" ToolTip="Память игровых данных Java. Лимит меняется в настройках и применяется после перезапуска."><StackPanel><TextBlock Text="ПАМЯТЬ" Foreground="#9BA6AF" FontSize="10"/><TextBlock x:Name="HeapMetric" Text="— / 8 ГБ" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock x:Name="HeapCaption" Text="Данные после запуска" Foreground="#7E8C96" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="6" Padding="16,14" ToolTip="Доля всех процессоров компьютера, используемая сервером."><StackPanel><TextBlock Text="НАГРУЗКА" Foreground="#9BA6AF" FontSize="10"/><TextBlock x:Name="CpuMetric" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock x:Name="CpuCaption" Text="Процессор компьютера" Foreground="#7E8C96" FontSize="10"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="6" Padding="16,14" ToolTip="Плавность — количество игровых тиков в секунду. Норма: 20."><StackPanel><TextBlock Text="ПЛАВНОСТЬ" Foreground="#9BA6AF" FontSize="10"/><TextBlock x:Name="TpsMetric" Text="— / 20" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock x:Name="TpsCaption" Text="Данные после запуска" Foreground="#7E8C96" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
    </UniformGrid>
    <Border x:Name="AdviceBorder" Grid.Row="3" Background="#2C3439" BorderBrush="#414B51" BorderThickness="1" CornerRadius="15" Padding="14,11" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#C69A7C" VerticalAlignment="Center"/><TextBlock x:Name="AdviceText" Grid.Column="1" Text="Всё готово к запуску. Позовите друзей и начните игру." TextWrapping="Wrap" Foreground="#ADB9C0" FontSize="12" LineHeight="18"/></Grid></Border>
    <Grid Grid.Row="4" Margin="2,13,2,0"><TextBlock x:Name="ActivityLabel" Text="Ожидание запуска" FontSize="10" Foreground="#788894"/><TextBlock x:Name="FooterLabel" Text="Данные появятся после запуска" FontSize="10" Foreground="#697984" HorizontalAlignment="Right"/></Grid>
   </Grid>
  </TabItem>
  <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" Margin="0,0,12,0"/><TextBlock Text="Игроки"/></StackPanel></TabItem.Header><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,23"><TextBlock Text="Кто сейчас в мире" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Здесь все, кто присоединился к вашей игре." Foreground="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel><Grid Grid.Row="1"><ListBox x:Name="PlayerList"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="12" Background="#39453F" Margin="0,0,15,0"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Foreground="#A2B99F" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="21"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Сейчас в игре" FontSize="11" Foreground="#91A38F" Margin="0,4,0,0"/></StackPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasItems,ElementName=PlayerList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Пока здесь тихо" FontSize="24" Foreground="#A0ADB6" HorizontalAlignment="Center"/><TextBlock Text="Игроки появятся после входа на сервер" Foreground="#748590" Margin="0,10,0,0"/></StackPanel></Grid></Grid></TabItem>
  <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Margin="0,0,12,0"/><TextBlock Text="Показатели"/></StackPanel></TabItem.Header><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,23"><TextBlock Text="Как работает сервер" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Следите за нагрузкой и оставляйте запас для своей игры." Foreground="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="25"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Использование памяти" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="За последние две минуты" Grid.Row="1" Foreground="{StaticResource Muted}" Margin="0,8,0,20" FontSize="12"/><Canvas x:Name="MemoryChart" Grid.Row="2" ClipToBounds="True" MinHeight="150"/><TextBlock x:Name="SystemMemoryLabel" Grid.Row="3" Text="Проверяем память компьютера…" Foreground="{StaticResource Muted}" Margin="0,20,0,0" FontSize="12"/></Grid></Border><TextBlock Grid.Row="2" Text="Если игра тормозит, дополнительная память поможет только при её нехватке. Генерация мира и сложные механизмы тоже создают нагрузку." TextWrapping="Wrap" Foreground="#8B9CA8" Margin="0,20,0,0" LineHeight="21"/></Grid></TabItem>
  <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,12,0"/><TextBlock Text="Настройки"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,8"><TextBlock Text="Под ваш компьютер" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Настройки можно менять, когда сервер остановлен." Foreground="{StaticResource Muted}" Margin="0,9,0,24"/><Border Style="{StaticResource Card}" Padding="26"><StackPanel><TextBlock x:Name="RamValue" Text="Память сервера · 8 ГБ" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Больше — не всегда лучше. Начните с 8 ГБ и следите за подсказками." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,18" FontSize="12"/><Slider x:Name="RamSlider" Minimum="4" Maximum="24" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,16"/><TextBlock x:Name="RamAdvice" Foreground="#8F9FA9" FontSize="12" TextWrapping="Wrap" LineHeight="20"/><Border Height="1" Background="#3D464D" Margin="0,25,0,24"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Мест для друзей" FontSize="17"/><TextBlock Text="Максимум игроков одновременно" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel><TextBox x:Name="MaxPlayersBox" Grid.Column="1" Text="10" FontSize="20" TextAlignment="Center"/></Grid></StackPanel></Border><Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="Сохранить настройки" HorizontalAlignment="Left" Padding="25,13" Margin="0,24,0,0"/><TextBlock x:Name="SettingsResult" Foreground="#B6C7AC" TextWrapping="Wrap" Margin="0,14,0,0"/><Expander Header="О сборке" Foreground="#8C9CA7" Margin="0,30,0,0"><TextBlock Text="TerraFirmaGreg-Modern 0.13.18 · Minecraft Java 1.20.1 · Forge 47.4.13 · Java 17. Панель 1.1.0." TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/></Expander></StackPanel></ScrollViewer></TabItem>
  <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71B;" Margin="0,0,12,0"/><TextBlock Text="Подключение"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,8"><TextBlock Text="Позовите друзей" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Сначала соедините ваши компьютеры общей закрытой сетью." Foreground="{StaticResource Muted}" Margin="0,9,0,24" TextWrapping="Wrap"/><Border Style="{StaticResource Card}" Padding="23" Margin="0,0,0,18"><StackPanel><TextBlock Text="Для вас на этом компьютере" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="В игре откройте «Сетевая игра → Прямое подключение»." Foreground="{StaticResource Muted}" Margin="0,9,0,14" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="localhost:25565" FontSize="23" Foreground="#D7AE8A" FontFamily="Consolas"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="23"><StackPanel><TextBlock Text="Адрес для друзей" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Выберите адаптер вашей общей сети и отправьте этот адрес друзьям." Foreground="{StaticResource Muted}" Margin="0,9,0,16" TextWrapping="Wrap" FontSize="12"/><ComboBox x:Name="AddressBox" Height="46"/><StackPanel Orientation="Horizontal" Margin="0,17,0,0"><Button x:Name="CopyAddressButton" Style="{StaticResource Primary}" Content="Скопировать адрес" Margin="0,0,10,0"/><Button x:Name="RefreshAddressButton" Content="Обновить"/></StackPanel><TextBlock x:Name="ConnectionResult" Foreground="#B6C7AC" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border><TextBlock Text="Адрес в списке не гарантирует доступность из интернета. Панель не создаёт VPN и не настраивает роутер или брандмауэр." TextWrapping="Wrap" Foreground="#8B9CA7" LineHeight="21" Margin="0,20,0,0"/><Border Background="#38322E" CornerRadius="12" Padding="15" Margin="0,18,0,0"><TextBlock Text="Проверка лицензии выключена: могут играть знакомые с лицензией и через TLauncher. Используйте только закрытую сеть — владельцы ников не проверяются." TextWrapping="Wrap" Foreground="#C7AB93" FontSize="12" LineHeight="20"/></Border></StackPanel></ScrollViewer></TabItem>
  <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Margin="0,0,12,0"/><TextBlock Text="События"/></StackPanel></TabItem.Header><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,22"><TextBlock Text="Что происходит" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Сообщения сервера. Предупреждение само по себе не означает ошибку." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel><Button x:Name="OpenLogButton" Grid.Row="1" Content="Открыть полный журнал  ↗" HorizontalAlignment="Left" Margin="0,0,0,18"/><Border Grid.Row="2" CornerRadius="17" Background="#1C2328" BorderBrush="#3B464E" BorderThickness="1" Padding="12"><TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="#A8B5BF" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/></Border></Grid></TabItem>
 </TabControl>
</Window>
