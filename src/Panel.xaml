<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TFG • Сервер для друзей" Width="1160" Height="810" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#10151C" Foreground="#E9EDF5" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#91A0B5"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#273343"/><Setter Property="Foreground" Value="#ECF3FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="17,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#98A8BE"/><Setter Property="Padding" Value="18,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="T" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#80E4BF"/><Setter TargetName="T" Property="BorderBrush" Value="#80E4BF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101720"/><Setter Property="Foreground" Value="#EAF0F8"/><Setter Property="BorderBrush" Value="#344153"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#151D28"/><Setter Property="Foreground" Value="#ECF3FA"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid Margin="28,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#274E43" CornerRadius="8" Padding="9,6" Margin="0,0,12,0"><TextBlock Text="TFG" FontWeight="Bold" Foreground="#91F1CA"/></Border><TextBlock Text="Сервер для друзей" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="TerraFirmaGreg 0.13.18  /  Minecraft 1.20.1  /  Forge 47.4.13" Foreground="{StaticResource Muted}" Margin="0,9,0,0" FontSize="12"/></StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="StateLabel" Text="●  Остановлен" Foreground="#A6B2C4" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="UptimeLabel" Text="Мир сохранён на этом компьютере" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#19232E" CornerRadius="12" Padding="18" Margin="0,0,0,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="StartButton" Content="▶  Запустить сервер" Background="#7CE1B7" Foreground="#10251E" Margin="0,0,10,0"/>
    <Button x:Name="SaveButton" Grid.Column="1" Content="Сохранить мир" IsEnabled="False" Margin="0,0,10,0"/>
    <Button x:Name="StopButton" Grid.Column="2" Content="■  Остановить" IsEnabled="False"/>
    <TextBlock x:Name="RunHint" Grid.Column="4" Text="Java 17 уже в комплекте" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/>
   </Grid>
  </Border>
  <UniformGrid Grid.Row="2" Columns="4" Margin="-5,0,-5,18">
   <Border Background="#19212C" CornerRadius="12" Margin="5" Padding="17"><StackPanel><TextBlock Text="ИГРОКИ ОНЛАЙН" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="PlayersMetric" Text="— / 10" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock x:Name="PlayersCaption" Text="Сервер не запущен" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
   <Border Background="#19212C" CornerRadius="12" Margin="5" Padding="17"><StackPanel><TextBlock Text="ПАМЯТЬ JAVA · HEAP" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="HeapMetric" Text="— / 8 ГБ" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock x:Name="HeapCaption" Text="Ожидание запуска" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
   <Border Background="#19212C" CornerRadius="12" Margin="5" Padding="17"><StackPanel><TextBlock Text="CPU · ДОЛЯ ВСЕГО ПК" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CpuMetric" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock x:Name="CpuCaption" Text="Нагрузка процесса сервера" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
   <Border Background="#19212C" CornerRadius="12" Margin="5" Padding="17"><StackPanel><TextBlock Text="ПРОИЗВОДИТЕЛЬНОСТЬ" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="TpsMetric" Text="— TPS" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock x:Name="TpsCaption" Text="Цель — 20 TPS" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
  </UniformGrid>
  <TabControl x:Name="Tabs" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0,18,0,0">
   <TabItem Header="Обзор"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#19212C" CornerRadius="12" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Память сервера" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Последние 2 минуты · занятая Java heap, не вся память процесса" Grid.Row="1" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,14"/><Canvas x:Name="MemoryChart" Grid.Row="2" ClipToBounds="True" MinHeight="100"/><TextBlock x:Name="SystemMemoryLabel" Grid.Row="3" Text="Проверка памяти компьютера…" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/></Grid></Border>
    <Border Grid.Column="2" Background="#19212C" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="Состояние и подсказки" FontSize="17" FontWeight="SemiBold"/><Border x:Name="AdviceBorder" Background="#22372F" CornerRadius="8" Padding="14" Margin="0,17,0,14"><TextBlock x:Name="AdviceText" Text="Всё готово к запуску. Первый старт сборки может занять несколько минут." TextWrapping="Wrap" Foreground="#B8EBD6" LineHeight="21"/></Border><TextBlock Text="Память применяется после перезапуска. Приложение ничего не увеличивает автоматически." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" LineHeight="19"/><Button x:Name="OpenFolderButton" Content="Открыть папку сервера" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#19212C" CornerRadius="10" Padding="14" Margin="0,14,0,0"><TextBlock x:Name="ActivityLabel" Text="После запуска здесь появятся события сервера." Foreground="#BCCADB" TextWrapping="Wrap" FontSize="12"/></Border>
   </Grid></TabItem>
   <TabItem Header="Игроки"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Список обновляется командой сервера. У каждого игрока должен быть свой уникальный ник." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,15"/><ListBox x:Name="PlayerList" Grid.Row="1" FontSize="18" Padding="18"/></Grid></TabItem>
   <TabItem Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Ресурсы сервера" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Меняйте настройки при остановленном сервере. По умолчанию — 8 ГБ для ПК с 32 ГБ ОЗУ." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,22"/><TextBlock x:Name="RamValue" Text="Лимит памяти: 8 ГБ" FontWeight="SemiBold"/><Slider x:Name="RamSlider" Minimum="4" Maximum="24" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" Width="570" Margin="0,14,0,10"/><TextBlock x:Name="RamAdvice" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21"/><StackPanel Orientation="Horizontal" Margin="0,24,0,20"><TextBlock Text="Максимум игроков" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBox x:Name="MaxPlayersBox" Text="10" Width="90"/></StackPanel><Button x:Name="ApplyButton" Content="Сохранить настройки" HorizontalAlignment="Left"/><TextBlock x:Name="SettingsResult" Foreground="#7CE1B7" Margin="0,12,0,0" TextWrapping="Wrap"/><Border Background="#262D37" Padding="16" CornerRadius="8" Margin="0,25,0,0"><TextBlock Text="Количество мест не означает расход памяти. Большие миры, механизмы и генерация чанков могут нагружать сервер даже с одним игроком." TextWrapping="Wrap" Foreground="#BAC6D7" LineHeight="21"/></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Подключение"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Как зайти в общий мир" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Хост на этом же компьютере подключается к localhost:25565. Остальные — к адресу хоста в общей сети." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,18"/><TextBlock Text="Адреса этого компьютера" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="AddressBox" Height="34" MaxWidth="780" HorizontalAlignment="Left" MinWidth="600"/><StackPanel Orientation="Horizontal" Margin="0,12,0,18"><Button x:Name="CopyAddressButton" Content="Скопировать адрес" Margin="0,0,10,0"/><Button x:Name="RefreshAddressButton" Content="Обновить"/></StackPanel><TextBlock x:Name="ConnectionResult" Foreground="#7CE1B7" Margin="0,0,0,12"/><Border Background="#292B23" Padding="17" CornerRadius="8"><TextBlock Text="Адрес в списке ещё не означает доступность из интернета. Для разных домов нужна общая закрытая виртуальная сеть либо отдельная настройка роутера и брандмауэра. Приложение эти настройки не меняет." TextWrapping="Wrap" Foreground="#E5D5A5" LineHeight="22"/></Border><TextBlock Text="Сервер настроен для лицензии и TLauncher без проверки владельца ника. Используйте его только в закрытой сети знакомых. Никогда не передавайте друг другу пароли Microsoft." TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21" Margin="0,18,0,0"/><TextBlock Text="У всех: TerraFirmaGreg-Modern 0.13.18 · Minecraft Java 1.20.1 · Forge 47.4.13." TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Журнал"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button x:Name="OpenLogButton" Content="Открыть полный журнал"/><TextBlock Text="  Здесь последние сообщения. WARN сам по себе не означает сбой." VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel><TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
  </TabControl>
  <Grid Grid.Row="4" Margin="0,17,0,0"><TextBlock Text="TFG CONTROL  /  WINDOWS" Foreground="#65768E" FontSize="10"/><TextBlock x:Name="FooterLabel" Text="Данные появятся после запуска сервера" Foreground="#65768E" FontSize="11" HorizontalAlignment="Right"/></Grid>
 </Grid>
</Window>
